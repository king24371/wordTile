; Godot project configuration for Word Tiles.
config_version=5

[application]

boot_splash/show_image=false
boot_splash/bg_color=Color(0.03137, 0.13725, 0.114, 1)
config/name="Word Tiles｜英文麻將"
config/description="單機英文拼字麻將：以字母牌組成外部字典確認的英文單字。"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/share/favicon-256.png"

[autoload]

TuningBridge="*res://scripts/manus/preview/tuning_adapter.gd"
ManusFontTheme="*res://autoload/manus_font_theme.gd"
SaveStore="*res://autoload/save_store.gd"
I18n="*res://autoload/i18n.gd"
TuningStore="*res://autoload/tuning_store.gd"
AudioDirector="*res://autoload/audio_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor]
import/use_multiple_threads=false
